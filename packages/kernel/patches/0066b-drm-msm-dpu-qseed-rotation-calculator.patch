+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Bounded escape from unsupported firmware dependencies. */
+#include <linux/linkage.h>
+.text
+SYM_FUNC_START(dpu_qseed_invoke)
+	bti c
+	stp x19, x20, [x0, #0]
+	stp x21, x22, [x0, #16]
+	stp x23, x24, [x0, #32]
+	stp x25, x26, [x0, #48]
+	stp x27, x28, [x0, #64]
+	stp x29, x30, [x0, #80]
+	str x18, [x0, #104]
+	mov x9, sp
+	str x9, [x0, #96]
+	mov x19, x0
+	mov x9, x1
+	mov x0, x2
+	mov x1, x3
+	mov x2, x4
+	mov x3, x5
+	blr x9
+	mov x9, x19
+.Lqs_return:
+	ldr x10, [x9, #96]
+	mov sp, x10
+	ldr x18, [x9, #104]
+	ldp x19, x20, [x9, #0]
+	ldp x21, x22, [x9, #16]
+	ldp x23, x24, [x9, #32]
+	ldp x25, x26, [x9, #48]
+	ldp x27, x28, [x9, #64]
+	ldp x29, x30, [x9, #80]
+	ret
+SYM_FUNC_END(dpu_qseed_invoke)
+SYM_FUNC_START(dpu_qseed_escape)
+	bti c
+	mov x9, x0
+	mov x0, #-95
+	b .Lqs_return
+SYM_FUNC_END(dpu_qseed_escape)
