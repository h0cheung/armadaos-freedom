From: TB322FC maintainers
Subject: [PATCH] drm/msm/dpu: calculate rotated QSEED sampling

Use the checksum-pinned QSEED 1.5.7 calculator for supported packed RGB
rotation, and retain the existing scaler when calculation is unavailable.

diff --git a/drivers/gpu/drm/msm/Kconfig b/drivers/gpu/drm/msm/Kconfig
index 250246f..061b001 100644
--- a/drivers/gpu/drm/msm/Kconfig
+++ b/drivers/gpu/drm/msm/Kconfig
@@ -112,6 +112,18 @@ config DRM_MSM_DPU
 	  the MSM DRM driver. It is the display controller found in devices
 	  using e.g. SDM845 and newer platforms.
 
+config DRM_MSM_QSEED_COMPAT
+	bool "Qualcomm QSEED calculator compatibility"
+	depends on DRM_MSM=y && DRM_MSM_DPU && ARM64 && KERNEL_MODE_NEON
+	depends on ARM64_4K_PAGES && !SHADOW_CALL_STACK
+	select FW_LOADER
+	select CRYPTO_LIB_SHA256
+	help
+	  Load the separately supplied, checksum-pinned QSEED library
+	  for native and upscaled packed RGB sampling. Unsupported geometry
+	  or calculation failures retain the driver's existing configuration.
+	  This option requires the MSM driver to be built into the kernel.
+
 config DRM_MSM_DP
 	bool "Enable DisplayPort support in MSM DRM driver"
 	depends on DRM_MSM
diff --git a/drivers/gpu/drm/msm/Makefile b/drivers/gpu/drm/msm/Makefile
index 45f4c2c..8e07bdf 100644
--- a/drivers/gpu/drm/msm/Makefile
+++ b/drivers/gpu/drm/msm/Makefile
@@ -163,6 +163,9 @@ msm-display-$(CONFIG_DRM_MSM_DSI_14NM_PHY) += dsi/phy/dsi_phy_14nm.o
 msm-display-$(CONFIG_DRM_MSM_DSI_10NM_PHY) += dsi/phy/dsi_phy_10nm.o
 msm-display-$(CONFIG_DRM_MSM_DSI_7NM_PHY) += dsi/phy/dsi_phy_7nm.o
 
+msm-display-$(CONFIG_DRM_MSM_QSEED_COMPAT) += disp/dpu1/dpu_qseed_compat.o \
+	disp/dpu1/dpu_qseed_invoke.o
+
 msm-y += $(adreno-y)
 msm-$(CONFIG_DRM_MSM_KMS) += $(msm-display-y)
 
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c
index 6f09f08..cfe2da6 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_plane.c
@@ -9,6 +9,9 @@
 
 #include <linux/debugfs.h>
 #include <linux/dma-buf.h>
+#include <linux/of.h>
+#include <linux/moduleparam.h>
+#include "dpu_qseed_compat.h"
 
 #include <drm/drm_atomic.h>
 #include <drm/drm_atomic_uapi.h>
@@ -58,6 +61,11 @@
 
 #define DEFAULT_REFRESH_RATE	60
 
+/* Applied when the plane is next programmed. */
+static bool dpu_binary_qseed = true;
+module_param(dpu_binary_qseed, bool, 0600);
+MODULE_PARM_DESC(dpu_binary_qseed, "Use the pinned QSEED calculator for RGB rotation/scaling");
+
 static const uint32_t qcom_compressed_supported_formats[] = {
 	DRM_FORMAT_ABGR8888,
 	DRM_FORMAT_ARGB8888,
@@ -528,9 +536,145 @@ static const struct dpu_csc_cfg *_dpu_plane_get_csc(struct dpu_sw_pipe *pipe,
 	return csc_ptr;
 }
 
+/* The binary is optional; failures preserve the normal scaler configuration. */
+static bool dpu_plane_setup_binary_qseed(
+	const struct drm_plane_state *state, const struct dpu_sw_pipe *pipe,
+	const struct dpu_sw_pipe_cfg *cfg, const struct msm_format *fmt,
+	const struct drm_format_info *info, struct dpu_hw_scaler3_cfg *scale,
+	struct dpu_hw_pixel_ext *ext)
+{
+#if IS_ENABLED(CONFIG_DRM_MSM_QSEED_COMPAT)
+	const struct dpu_plane_state *pstate;
+	struct dpu_qseed_input input = { 0 };
+	struct dpu_qseed_result result;
+	const struct dpu_qseed_path *p;
+	struct device *dev;
+	u32 i, n, index, count;
+
+	if (!READ_ONCE(dpu_binary_qseed) || !state || !state->fb ||
+	    state->rotation != DRM_MODE_ROTATE_270 ||
+	    cfg->rotation != DRM_MODE_ROTATE_90 ||
+	    pipe->sspp->cap->sblk->scaler_blk.version != 0x30004 ||
+	    pipe->multirect_index != DPU_SSPP_RECT_SOLO ||
+	    pipe->multirect_mode != DPU_SSPP_MULTIRECT_NONE ||
+	    MSM_FORMAT_IS_YUV(fmt) || info->num_planes != 1 ||
+	    info->cpp[0] != 4 || info->hsub != 1 || info->vsub != 1 ||
+	    ((state->src.x1 | state->src.y1 | state->src.x2 | state->src.y2) &
+	     0xffff) ||
+	    state->dst.x1 || state->dst.y1 || state->dst.x2 <= 0 ||
+	    state->dst.y2 <= 0 || state->dst.x2 > 8192 || state->dst.y2 > 8192)
+		return false;
+	input.fb_width = state->fb->width;
+	input.fb_height = state->fb->height;
+	input.src_x = state->src.x1 >> 16;
+	input.src_y = state->src.y1 >> 16;
+	input.src_width = drm_rect_width(&state->src) >> 16;
+	input.src_height = drm_rect_height(&state->src) >> 16;
+	input.dst_height = state->dst.y2;
+	input.ten_bit = !!MSM_FORMAT_IS_DX(fmt);
+	/* First cover native and upscaled packed RGB; no new downscale filters. */
+	if (input.src_width < 32 || input.src_height < 32 ||
+	    input.src_width > input.dst_height || input.src_height > state->dst.x2 ||
+	    input.fb_width > 8192 || input.fb_height > 8192)
+		return false;
+	pstate = to_dpu_plane_state(state);
+	count = drm_rect_width(&pstate->pipe_cfg[1].src_rect) ? 2 : 1;
+	index = cfg == &pstate->pipe_cfg[0] ? 0 : 1;
+	if (index >= count || cfg != &pstate->pipe_cfg[index])
+		return false;
+	for (n = 0; n < count; n++) {
+		if (pstate->pipe_cfg[n].dst_rect.y1 != state->dst.y1 ||
+		    pstate->pipe_cfg[n].dst_rect.y2 != state->dst.y2 ||
+		    !pstate->pipe[n].sspp ||
+		    pstate->pipe[n].sspp->cap->sblk->scaler_blk.version !=
+			    0x30004 ||
+		    pstate->pipe[n].multirect_index != DPU_SSPP_RECT_SOLO ||
+		    pstate->pipe[n].multirect_mode != DPU_SSPP_MULTIRECT_NONE)
+			return false;
+		input.dst_width[n] =
+			drm_rect_width(&pstate->pipe_cfg[n].dst_rect);
+	}
+	if (input.dst_width[0] + input.dst_width[1] != state->dst.x2)
+		return false;
+	dev = state->plane->dev->dev;
+	if (dpu_qseed_calculate(dev, &input, &result))
+		return false;
+	if (!result.step_x || result.step_x > 0xffffff || !result.step_y ||
+	    result.step_y > 0xffffff)
+		goto invalid;
+	/* Validate both pipes before applying either pipe's result. */
+	for (n = 0; n < count; n++) {
+		const struct drm_rect *src = &pstate->pipe_cfg[n].src_rect;
+		const struct drm_rect *dst = &pstate->pipe_cfg[n].dst_rect;
+		p = &result.path[n];
+		if (p->src_x != src->x1 || p->src_y != src->y1 ||
+		    p->src_width != drm_rect_width(src) ||
+		    p->src_height != drm_rect_height(src) ||
+		    p->dst_x != dst->x1 || p->dst_y != dst->y1 ||
+		    p->dst_width != drm_rect_width(dst) ||
+		    p->dst_height != drm_rect_height(dst) ||
+		    p->phase_x > 0x1fffff || p->phase_y > 0x1fffff ||
+		    p->preload_x > 127 || p->preload_y > 127 || !p->width ||
+		    p->width > 1088 || !p->height || p->height > 8192)
+			goto invalid;
+		for (i = 0; i < DPU_MAX_PLANES; i++) {
+			if (p->left_fetch[i] > 255 || p->left_repeat[i] > 255 ||
+			    p->right_fetch[i] > 255 ||
+			    p->right_repeat[i] > 255 || p->top_fetch[i] > 255 ||
+			    p->top_repeat[i] > 255 ||
+			    p->bottom_fetch[i] > 255 ||
+			    p->bottom_repeat[i] > 255 ||
+			    p->left_fetch[i] > p->src_x ||
+			    p->top_fetch[i] > p->src_y ||
+			    p->src_x + p->src_width + p->right_fetch[i] >
+				    input.fb_width ||
+			    p->src_y + p->src_height + p->bottom_fetch[i] >
+				    input.fb_height ||
+			    p->req_width[i] != p->height ||
+			    p->req_height[i] != p->width)
+				goto invalid;
+		}
+	}
+	p = &result.path[index];
+	for (i = 0; i < DPU_MAX_PLANES; i++) {
+		scale->phase_step_x[i] = result.step_x;
+		scale->phase_step_y[i] = result.step_y;
+		scale->init_phase_x[i] = p->phase_x;
+		scale->init_phase_y[i] = p->phase_y;
+		scale->preload_x[i] = p->preload_x;
+		scale->preload_y[i] = p->preload_y;
+		scale->src_width[i] = p->width;
+		scale->src_height[i] = p->height;
+		ext->left_ftch[i] = p->left_fetch[i];
+		ext->left_rpt[i] = p->left_repeat[i];
+		ext->right_ftch[i] = p->right_fetch[i];
+		ext->right_rpt[i] = p->right_repeat[i];
+		ext->top_ftch[i] = p->top_fetch[i];
+		ext->top_rpt[i] = p->top_repeat[i];
+		ext->btm_ftch[i] = p->bottom_fetch[i];
+		ext->btm_rpt[i] = p->bottom_repeat[i];
+		ext->num_ext_pxls_left[i] = p->req_width[i];
+		ext->num_ext_pxls_right[i] = 0;
+		ext->num_ext_pxls_top[i] = p->req_height[i];
+		ext->num_ext_pxls_btm[i] = 0;
+		ext->roi_w[i] = 0;
+		ext->roi_h[i] = 0;
+	}
+	return true;
+invalid:
+	dev_warn_ratelimited(
+		dev,
+		"QSEED binary geometry/range validation failed: src %ux%u dst %ux%u pipes %u; using existing scaler\n",
+		input.src_width, input.src_height, state->dst.x2, state->dst.y2,
+		count);
+#endif
+	return false;
+}
+
 static void _dpu_plane_setup_scaler(struct dpu_sw_pipe *pipe,
 		const struct msm_format *fmt, bool color_fill,
-		struct dpu_sw_pipe_cfg *pipe_cfg)
+		struct dpu_sw_pipe_cfg *pipe_cfg,
+		const struct drm_plane_state *state)
 {
 	struct dpu_hw_sspp *pipe_hw = pipe->sspp;
 	const struct drm_format_info *info = drm_format_info(fmt->pixel_format);
@@ -559,6 +703,10 @@ static void _dpu_plane_setup_scaler(struct dpu_sw_pipe *pipe,
 	_dpu_plane_setup_pixel_ext(&scaler3_cfg, &pixel_ext,
 			src_width, src_height, info->hsub, info->vsub);
 
+	if (!color_fill)
+		dpu_plane_setup_binary_qseed(state, pipe, pipe_cfg, fmt, info,
+						   &scaler3_cfg, &pixel_ext);
+
 	if (pipe_hw->ops.setup_pe)
 		pipe_hw->ops.setup_pe(pipe_hw,
 				&pixel_ext);
@@ -605,7 +753,7 @@ static void _dpu_plane_color_fill_pipe(struct dpu_plane_state *pstate,
 	if (pipe->sspp->ops.setup_rects)
 		pipe->sspp->ops.setup_rects(pipe, &pipe_cfg);
 
-	_dpu_plane_setup_scaler(pipe, fmt, true, &pipe_cfg);
+	_dpu_plane_setup_scaler(pipe, fmt, true, &pipe_cfg, NULL);
 }
 
 /**
@@ -1528,7 +1676,7 @@ static void dpu_plane_sspp_update_pipe(struct drm_plane *plane,
 				pipe_cfg);
 	}
 
-	_dpu_plane_setup_scaler(pipe, fmt, false, pipe_cfg);
+	_dpu_plane_setup_scaler(pipe, fmt, false, pipe_cfg, state);
 
 	if (pipe->sspp->ops.setup_multirect)
 		pipe->sspp->ops.setup_multirect(
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_qseed_compat.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_qseed_compat.c
new file mode 100644
index 0000000..1e7a170
--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_qseed_compat.c
@@ -0,0 +1,510 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Qualcomm stock-QSEED adapter. The pinned opaque ELF is supplied separately. */
+#include <linux/device.h>
+#include <linux/firmware.h>
+#include <linux/jiffies.h>
+#include <linux/mutex.h>
+#include <linux/module.h>
+#include <crypto/sha2.h>
+#include "dpu_qseed_compat.h"
+#include <linux/kernel.h>
+#include <linux/execmem.h>
+#include <linux/fpu.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+#include <linux/vmalloc.h>
+#include <asm/cacheflush.h>
+#include <asm/fpsimd.h>
+#include <asm/set_memory.h>
+#include <asm/simd.h>
+#include "dpu_qseed_data.h"
+
+extern long dpu_qseed_invoke(void *save, void *fn, unsigned long a,
+			     unsigned long b, unsigned long c, unsigned long d);
+extern void dpu_qseed_escape(void *save) __noreturn;
+static u64 jump_state[14];
+static DEFINE_MUTEX(qs_lock);
+static u8 *qs_base, *qs_work;
+static unsigned long qs_retry;
+static const char *qs_stage;
+static bool qs_disabled;
+struct qs_cached {
+	bool valid;
+	struct dpu_qseed_input input;
+	struct dpu_qseed_result result;
+};
+static struct qs_cached qs_cache[4];
+static unsigned int qs_next_cache;
+static u8 *arena;
+static size_t arena_used;
+static unsigned int unexpected;
+static const char *qs_bad_import;
+static void *stdout_fake;
+static unsigned long guard = 0x2a9c7015ec34d800;
+static u64 private_tls[16] = { [5] = 0x2a9c7015ec34d800 };
+
+static void *qs_copy(void *d, const void *s, size_t n)
+{
+	return memcpy(d, s, n);
+}
+static void *qs_clear(void *d, int c, size_t n)
+{
+	return memset(d, c, n);
+}
+static void qs_unexpected(void)
+{
+	unexpected++;
+	dpu_qseed_escape(jump_state);
+}
+static void *qs_new(size_t size)
+{
+	void *p;
+	if (size > SZ_1M - arena_used || ALIGN(size, 16) > SZ_1M - arena_used) {
+		qs_unexpected();
+		return NULL;
+	}
+	p = arena + arena_used;
+	arena_used += ALIGN(size, 16);
+	return p;
+}
+static void qs_delete(void *p)
+{
+}
+static int qs_property(const char *key, char *value)
+{
+	*value = 0;
+	return 0;
+}
+static int qs_atexit(void *a, void *b, void *c)
+{
+	return 0;
+}
+static void qs_finalize(void *p)
+{
+}
+static unsigned long qs_auxval(unsigned long key)
+{
+	return key == 16 ? 3 : 0;
+}
+
+static void qs_missing(unsigned int index)
+{
+	qs_bad_import = qs_imports[index];
+	qs_unexpected();
+}
+static void qs_bad_0(void)
+{
+	qs_missing(0);
+}
+static void qs_bad_1(void)
+{
+	qs_missing(1);
+}
+static void qs_bad_2(void)
+{
+	qs_missing(2);
+}
+static void qs_bad_3(void)
+{
+	qs_missing(3);
+}
+static void qs_bad_4(void)
+{
+	qs_missing(4);
+}
+static void qs_bad_5(void)
+{
+	qs_missing(5);
+}
+static void qs_bad_6(void)
+{
+	qs_missing(6);
+}
+static void qs_bad_7(void)
+{
+	qs_missing(7);
+}
+static void qs_bad_8(void)
+{
+	qs_missing(8);
+}
+static void qs_bad_9(void)
+{
+	qs_missing(9);
+}
+static void qs_bad_10(void)
+{
+	qs_missing(10);
+}
+static void qs_bad_11(void)
+{
+	qs_missing(11);
+}
+static void qs_bad_12(void)
+{
+	qs_missing(12);
+}
+static void qs_bad_13(void)
+{
+	qs_missing(13);
+}
+static void qs_bad_14(void)
+{
+	qs_missing(14);
+}
+static void qs_bad_15(void)
+{
+	qs_missing(15);
+}
+static void qs_bad_16(void)
+{
+	qs_missing(16);
+}
+static void qs_bad_17(void)
+{
+	qs_missing(17);
+}
+static void qs_bad_18(void)
+{
+	qs_missing(18);
+}
+static void qs_bad_19(void)
+{
+	qs_missing(19);
+}
+static void qs_bad_20(void)
+{
+	qs_missing(20);
+}
+static void qs_bad_21(void)
+{
+	qs_missing(21);
+}
+static void qs_bad_22(void)
+{
+	qs_missing(22);
+}
+static void qs_bad_23(void)
+{
+	qs_missing(23);
+}
+static void qs_bad_24(void)
+{
+	qs_missing(24);
+}
+static void qs_bad_25(void)
+{
+	qs_missing(25);
+}
+static void qs_bad_26(void)
+{
+	qs_missing(26);
+}
+static void (*const qs_bad_imports[])(void) = {
+	qs_bad_0,  qs_bad_1,  qs_bad_2,	 qs_bad_3,  qs_bad_4,  qs_bad_5,
+	qs_bad_6,  qs_bad_7,  qs_bad_8,	 qs_bad_9,  qs_bad_10, qs_bad_11,
+	qs_bad_12, qs_bad_13, qs_bad_14, qs_bad_15, qs_bad_16, qs_bad_17,
+	qs_bad_18, qs_bad_19, qs_bad_20, qs_bad_21, qs_bad_22, qs_bad_23,
+	qs_bad_24, qs_bad_25, qs_bad_26
+};
+
+static unsigned long qs_external(const char *name)
+{
+#define FN(n, f)              \
+	if (!strcmp(name, n)) \
+	return (unsigned long)(f)
+	FN("memcpy", qs_copy);
+	FN("memset", qs_clear);
+	FN("_Znwm", qs_new);
+	FN("_Znam", qs_new);
+	FN("_ZdlPv", qs_delete);
+	FN("_ZdaPv", qs_delete);
+	FN("__system_property_get", qs_property);
+	FN("__cxa_atexit", qs_atexit);
+	FN("__cxa_finalize", qs_finalize);
+	FN("getauxval", qs_auxval);
+	FN("strlen", strlen);
+	FN("strncmp", strncmp);
+	FN("stdout", &stdout_fake);
+	FN("__stack_chk_guard", &guard);
+#undef FN
+	{
+		unsigned int i;
+		for (i = 0; i < ARRAY_SIZE(qs_imports); i++)
+			if (!strcmp(name, qs_imports[i]))
+				return (unsigned long)qs_bad_imports[i];
+	}
+	return (unsigned long)qs_unexpected;
+}
+
+static long qs_call(void *fn, void *a, void *b, void *c, unsigned long d)
+{
+	u64 fpcr, fpsr;
+	long ret;
+	if (!may_use_simd())
+		return -EAGAIN;
+	kernel_fpu_begin();
+	fpcr = read_sysreg_s(SYS_FPCR);
+	fpsr = read_sysreg_s(SYS_FPSR);
+	write_sysreg_s(0, SYS_FPCR);
+	write_sysreg_s(0, SYS_FPSR);
+	ret = dpu_qseed_invoke(jump_state, fn, (unsigned long)a,
+			       (unsigned long)b, (unsigned long)c, d);
+	write_sysreg_s(fpcr, SYS_FPCR);
+	write_sysreg_s(fpsr, SYS_FPSR);
+	kernel_fpu_end();
+	return ret;
+}
+
+/* The pinned ABI is private to this driver, never a userspace/kernel ABI. */
+static void qs_decode(const u32 *raw, struct dpu_qseed_result *result)
+{
+	unsigned int n, c;
+	memset(result, 0, sizeof(*result));
+	result->step_x = raw[6];
+	result->step_y = raw[7];
+	for (n = 0; n < 2; n++) {
+		const u32 *p = raw + n * 130;
+		struct dpu_qseed_path *d = &result->path[n];
+		d->src_x = p[10];
+		d->src_y = p[11];
+		d->src_width = p[12];
+		d->src_height = p[13];
+		d->dst_width = p[14];
+		d->dst_height = p[15];
+		d->dst_x = p[16];
+		d->dst_y = p[17];
+		d->phase_x = p[58];
+		d->phase_y = p[59];
+		d->preload_x = p[62];
+		d->preload_y = p[63];
+		d->width = p[66];
+		d->height = p[67];
+		for (c = 0; c < 4; c++) {
+			d->left_repeat[c] = p[18 + c];
+			d->left_fetch[c] = p[22 + c];
+			d->right_repeat[c] = p[26 + c];
+			d->right_fetch[c] = p[30 + c];
+			d->top_repeat[c] = p[34 + c];
+			d->top_fetch[c] = p[38 + c];
+			d->bottom_repeat[c] = p[42 + c];
+			d->bottom_fetch[c] = p[46 + c];
+			d->req_width[c] = p[50 + c];
+			d->req_height[c] = p[54 + c];
+		}
+	}
+}
+
+static int qs_load(struct device *dev)
+{
+	static const u8 expected[SHA256_DIGEST_SIZE] = {
+		0xed, 0xf5, 0x65, 0x56, 0xef, 0x87, 0x8c, 0x24,
+		0xcf, 0xc1, 0x6d, 0x04, 0xa5, 0x7e, 0x0c, 0xea,
+		0x50, 0xbf, 0xba, 0x20, 0x15, 0xa1, 0xac, 0xa8,
+		0x5d, 0x51, 0x0f, 0x87, 0x0e, 0xcb, 0xac, 0x39
+	};
+	static const u32 segments[][2] = { { 0, 0x12224 },
+					   { 0x14000, 0x39218 },
+					   { 0x50000, 0x7d8 },
+					   { 0x54000, 0x2a10 } };
+	const struct firmware *fw;
+	u8 digest[SHA256_DIGEST_SIZE];
+	u32 init[19] = { 0x1050007, 8, 8, 1 };
+	unsigned int i;
+	int ret;
+
+	unexpected = 0;
+	qs_bad_import = NULL;
+	qs_stage = "firmware load";
+	ret = request_firmware_direct(&fw, "qcom/libqseed3.so", dev);
+	if (ret)
+		return ret;
+	qs_stage = "firmware checksum";
+	sha256(fw->data, fw->size, digest);
+	if (fw->size != 356840 || memcmp(digest, expected, sizeof(digest))) {
+		release_firmware(fw);
+		return -EBADMSG;
+	}
+	qs_stage = "memory allocation";
+	arena = vzalloc(SZ_1M);
+	qs_base = execmem_alloc_rw(EXECMEM_DEFAULT, 0x5c000);
+	qs_work = kvzalloc(760 + 1036 + 3008, GFP_KERNEL);
+	if (!arena || !qs_base || !qs_work) {
+		ret = -ENOMEM;
+		goto release;
+	}
+	memset(qs_base, 0, 0x5c000);
+	for (i = 0; i < ARRAY_SIZE(segments); i++)
+		memcpy(qs_base + segments[i][0], fw->data + segments[i][0],
+		       segments[i][1]);
+	for (i = 0; i < ARRAY_SIZE(qs_relocs); i++) {
+		const struct qs_reloc *r = &qs_relocs[i];
+		u64 v = r->external ? qs_external(qs_imports[r->external - 1]) :
+				      (u64)qs_base;
+		*(u64 *)(qs_base + r->offset) = v + r->addend;
+	}
+	/* Substitute Android TLS canary reads without changing task TPIDR_EL0. */
+	*(u64 *)(qs_base + QS_TLS_LITERAL) = (u64)private_tls;
+	for (i = 0; i < ARRAY_SIZE(qs_tls_reads); i++) {
+		u32 a = qs_tls_reads[i], v = *(u32 *)(qs_base + a);
+		u32 delta = ((s32)QS_TLS_LITERAL - (s32)a) / 4;
+		*(u32 *)(qs_base + a) = 0x58000000 | ((delta & 0x7ffff) << 5) |
+					(v & 31);
+	}
+	/* Disable formatting only; scaler calculation instructions stay unchanged. */
+	for (i = 0; i < ARRAY_SIZE(qs_log_entries); i++) {
+		*(u32 *)(qs_base + qs_log_entries[i]) = 0xd503245f;
+		*(u32 *)(qs_base + qs_log_entries[i] + 4) = 0xd65f03c0;
+	}
+	qs_stage = "memory protections";
+	ret = set_memory_ro((unsigned long)qs_base, 0x50000 / PAGE_SIZE);
+	if (ret)
+		goto release;
+	ret = set_memory_x((unsigned long)qs_base + 0x14000,
+			   0x3c000 / PAGE_SIZE);
+	if (ret)
+		goto release;
+	flush_icache_range((unsigned long)qs_base + 0x14000,
+			   (unsigned long)qs_base + 0x50000);
+	qs_stage = "constructors";
+	for (i = 0; i < ARRAY_SIZE(qs_ctors); i++) {
+		qs_call(qs_base + qs_ctors[i], NULL, NULL, NULL, 0);
+		if (unexpected) {
+			ret = -EOPNOTSUPP;
+			goto release;
+		}
+	}
+	qs_stage = "library version";
+	if (qs_call(qs_base + QS_VERSION, NULL, NULL, NULL, 0) != 0x1050007) {
+		ret = -EINVAL;
+		goto release;
+	}
+	qs_stage = "library init";
+	ret = qs_call(qs_base + QS_INIT, init, NULL, NULL, 0);
+	if (unexpected)
+		ret = -EOPNOTSUPP;
+	if (!ret)
+		dev_info(
+			dev,
+			"QSEED 1.5.7 binary calculator ready (bilinear override, RX text, RW/NX data)\n");
+release:
+	release_firmware(fw);
+	if (ret) {
+		if (qs_base)
+			execmem_free(qs_base);
+		vfree(arena);
+		kvfree(qs_work);
+		qs_base = NULL;
+		arena = NULL;
+		qs_work = NULL;
+		arena_used = 0;
+		unexpected = 0;
+	}
+	return ret;
+}
+
+int dpu_qseed_calculate(struct device *dev, const struct dpu_qseed_input *in,
+			struct dpu_qseed_result *result)
+{
+	u32 *input, *output, *force;
+	unsigned int i, slot;
+	int ret = 0;
+	if (!in_task() || in_atomic() || irqs_disabled() || !may_use_simd()) {
+		dev_warn_ratelimited(
+			dev,
+			"QSEED binary: invalid execution context; using existing scaler\n");
+		return -EAGAIN;
+	}
+	mutex_lock(&qs_lock);
+	qs_stage = "input validation";
+	if (!in->fb_width || !in->fb_height || in->fb_width > 8192 ||
+	    in->fb_height > 8192 || in->src_width < 32 ||
+	    in->src_width > 8192 || in->src_height < 32 ||
+	    in->src_height > 8192 || in->src_x > in->fb_width ||
+	    in->src_width > in->fb_width - in->src_x ||
+	    in->src_y > in->fb_height ||
+	    in->src_height > in->fb_height - in->src_y || !in->dst_width[0] ||
+	    in->dst_width[0] > 8192 || in->dst_width[1] > 8192 ||
+	    in->dst_width[0] + in->dst_width[1] > 8192 ||
+	    !in->dst_height || in->dst_height > 8192 || in->ten_bit > 1) {
+		ret = -EINVAL;
+		goto fail;
+	}
+	if (qs_disabled) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	if (!qs_base) {
+		if (qs_retry && time_before(jiffies, qs_retry)) {
+			ret = -EAGAIN;
+			goto unlock;
+		}
+		qs_retry = jiffies + 5 * HZ;
+		ret = qs_load(dev);
+		if (ret)
+			goto fail;
+	}
+	for (i = 0; i < ARRAY_SIZE(qs_cache); i++)
+		if (qs_cache[i].valid &&
+		    !memcmp(&qs_cache[i].input, in, sizeof(*in))) {
+			*result = qs_cache[i].result;
+			goto unlock;
+		}
+	qs_stage = "calculation";
+	unexpected = 0;
+	qs_bad_import = NULL;
+	input = (u32 *)qs_work;
+	force = (u32 *)(qs_work + 760);
+	output = (u32 *)(qs_work + 760 + 1036);
+	memset(qs_work, 0, 760 + 1036 + 3008);
+	input[1] = 2;
+	input[2] = 1;
+	input[3] = in->dst_width[1] ? 1 : 0;
+	input[6] = 16 | 1024 | (in->ten_bit ? 128 : 0);
+	input[10] = in->fb_width;
+	input[11] = in->fb_height;
+	input[12] = in->src_x;
+	input[13] = in->src_y;
+	input[14] = in->src_width;
+	input[15] = in->src_height;
+	input[16] = in->dst_width[0];
+	input[17] = in->dst_width[1];
+	input[20] = in->dst_height;
+	input[21] =
+		15; /* Repeat outer ROI edges; fetch only across the interior split. */
+	/* Original process() 0x17a20: override bit 2 reads y_rgb_cfg at offset 12.
+	 * Select the existing bilinear filter before the library computes sampling. */
+	force[0] = BIT(2);
+	force[3] = 3;
+	ret = qs_call(qs_base + QS_CALC, input, qs_work + 760, output, 0);
+	if (unexpected) {
+		ret = -EOPNOTSUPP;
+		qs_disabled = true;
+	}
+	if (ret)
+		goto fail;
+	/* Keep the driver's existing bilinear filters; other filter modes fall back. */
+	qs_stage = "filter validation";
+	if (output[2] != 3 || output[3] != 1 || output[4] != 1) {
+		ret = -ERANGE;
+		goto fail;
+	}
+	qs_decode(output, result);
+	slot = qs_next_cache++ % ARRAY_SIZE(qs_cache);
+	qs_cache[slot].input = *in;
+	qs_cache[slot].result = *result;
+	qs_cache[slot].valid = true;
+	goto unlock;
+fail:
+	dev_warn_ratelimited(
+		dev,
+		"QSEED binary %s failed (%d), src %ux%u+%u+%u fb %ux%u dst %u+%ux%u unsupported=%s; using existing scaler\n",
+		qs_stage, ret, in->src_width, in->src_height, in->src_x,
+		in->src_y, in->fb_width, in->fb_height, in->dst_width[0],
+		in->dst_width[1], in->dst_height, qs_bad_import ?: "none");
+unlock:
+	mutex_unlock(&qs_lock);
+	return ret;
+}
+
+MODULE_FIRMWARE("qcom/libqseed3.so");
