+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _DPU_QSEED_COMPAT_H
+#define _DPU_QSEED_COMPAT_H
+#include <linux/types.h>
+struct device;
+
+struct dpu_qseed_input {
+	u32 fb_width, fb_height;
+	u32 src_x, src_y, src_width, src_height;
+	u32 dst_width[2], dst_height;
+	u32 ten_bit;
+};
+
+struct dpu_qseed_path {
+	u32 src_x, src_y, src_width, src_height;
+	u32 dst_x, dst_y, dst_width, dst_height;
+	u32 phase_x, phase_y, preload_x, preload_y, width, height;
+	u32 left_fetch[4], left_repeat[4], right_fetch[4], right_repeat[4];
+	u32 top_fetch[4], top_repeat[4], bottom_fetch[4], bottom_repeat[4];
+	u32 req_width[4], req_height[4];
+};
+
+struct dpu_qseed_result {
+	u32 step_x, step_y;
+	struct dpu_qseed_path path[2];
+};
+
+int dpu_qseed_calculate(struct device *dev, const struct dpu_qseed_input *in,
+			struct dpu_qseed_result *out);
+#endif
